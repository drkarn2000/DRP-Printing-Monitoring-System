# DRP Printing Monitoring System Environment Configuration
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://drp_user:drp_password@localhost:5432/drp_db?schema=public
DIRECT_URL=postgresql://drp_user:drp_password@localhost:5432/drp_db?schema=public

# JWT Security
JWT_SECRET=drp-super-secret-jwt-key-2026-production-ready-security
JWT_EXPIRES_IN=24h
COOKIE_SECRET=drp-cookie-secret-key-32chars-long-prod

# CORS & Gateway
FRONTEND_URL=http://localhost:3000
CONNECTOR_API_KEY=drp-connector-api-key-safe-2026

# Storage
STORAGE_DIR=./uploads
MAX_FILE_SIZE_MB=50
